{
  "name": "tab-triage",
  "version": "1.0.1",
  "private": true,
  "description": "Chrome extension that sorts open tabs into native tab groups using calibrated decisions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:label": "tsx eval/label.ts",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "demo": "tsx --env-file-if-exists=.env demo/run.ts",
    "test:e2e": "npm run build && tsx test/e2e/smoke.ts",
    "probe": "tsx --env-file-if-exists=.env eval/probe.ts",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
